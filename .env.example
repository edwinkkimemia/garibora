# Database — use Neon or Supabase Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/garibora?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/garibora?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Set to "true" only when Google OAuth above is configured — shows the Google button
NEXT_PUBLIC_GOOGLE_ENABLED=""
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="https://motiva.co.ke"
NEXT_PUBLIC_BRAND_NAME="Motiva"
NEXT_PUBLIC_WHATSAPP_NUMBER="254729396174"

# Images — Uploadthing (direct uploads on /sell)
UPLOADTHING_TOKEN=""
# Set to "true" once UPLOADTHING_TOKEN is configured — shows the upload button
NEXT_PUBLIC_UPLOADTHING_ENABLED=""

# Payments — M-Pesa Daraja STK push (set in Vercel, never commit values)
MPESA_ENV="production"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
# Business shortcode (BusinessShortCode + password) + Till (PartyB). For pure paybill mode, set both to the paybill and use CustomerPayBillOnline.
MPESA_STORE_SHORTCODE=""
MPESA_TILL_NUMBER=""
MPESA_SHORTCODE=""
MPESA_TRANSACTION_TYPE="CustomerBuyGoodsOnline"
MPESA_PASSKEY=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

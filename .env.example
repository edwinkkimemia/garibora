# Database — use Neon or Supabase Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/garibora?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/garibora?schema=public"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Set to "true" only when Google OAuth above is configured — shows the Google button
NEXT_PUBLIC_GOOGLE_ENABLED=""
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="https://motiva.co.ke"
NEXT_PUBLIC_BRAND_NAME="Motiva"
NEXT_PUBLIC_WHATSAPP_NUMBER="254700000000"

# Images — Uploadthing (direct uploads on /sell)
UPLOADTHING_TOKEN=""
# Set to "true" once UPLOADTHING_TOKEN is configured — shows the upload button
NEXT_PUBLIC_UPLOADTHING_ENABLED=""

# Payments (placeholders)
NEXT_PUBLIC_MPESE_DARAJA_CONSUMER_KEY=""
MPESE_DARAJA_CONSUMER_SECRET=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
